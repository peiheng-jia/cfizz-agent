# Local experiment data and generated results (never commit or upload)
# Keep only the small README placeholders that explain how to provide data.
demo/**
!demo/
!demo/README.md
!demo/cases/
!demo/cases/README.md
!demo/data/
!demo/data/README.md
data/**
!data/
!data/README.md

# Optional top-level reference overrides (documented by references/**/README.md).
# The one packaged hg38 reference lives under src/cfizz/agent/resources/ and is
# intentionally tracked; local replacements in this root directory stay ignored.
references/hg38/**
!references/hg38/
!references/hg38/README.md
references/**/*.gtf
references/**/*.gtf.gz
references/**/*.gff
references/**/*.gff.gz
references/**/*.bgz
references/**/*.tbi
references/**/gene_index.json.gz
references/**/*.sorted.gtf.gz

# Legacy / dev intermediate artifacts (do NOT release)
_full_pipeline_results/            # 旧 hPSC dev scripts 产物
**/examples_hPSC/                   # 同上,任何 _hPSC 子目录
__pycache__/                        # Python bytecode(预防)
*.pyc
*.pyo

# Local scripts / scratch (not for distribution)
scratch/
_tmp_*
*.tmp.py
